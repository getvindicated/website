BREVO_API_KEY=
NEXT_PUBLIC_SITE_URL=https://www.getvindicated.org

# --- /board (private board hub) ---
# Railway Postgres connection string (Railway sets this when you add the
# Postgres service and reference it from the website service).
DATABASE_URL=
# Cloudflare Access: your team domain and the /board application's
# Audience (AUD) tag. See CLOUDFLARE_ACCESS.md.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Local development only: pretend to be this signed-in email on /board.
# Ignored unless NODE_ENV is "development" (pnpm dev), so it can't apply
# to the deployed site. Leave empty in Railway.
BOARD_DEV_EMAIL=
