BREVO_API_KEY=
NEXT_PUBLIC_SITE_URL=https://www.getvindicated.org

# --- /board (password-protected board hub) ---
# Railway Postgres connection string (Railway sets this when you add the
# Postgres service and reference it from the website service).
DATABASE_URL=
# Passwords for /board. Everyone on the board gets BOARD_PASSWORD (view and
# submit). Rana gets BOARD_ADMIN_PASSWORD (edit everything). Whoever runs
# socials gets BOARD_SOCIALS_PASSWORD (edit socials); no one has it right
# now, so leave it empty. Changing one signs out everyone who used it.
BOARD_PASSWORD=
BOARD_ADMIN_PASSWORD=
BOARD_SOCIALS_PASSWORD=
# Passwords for /board/ucla (UCLA's hub). Fiona and Will get
# BOARD_UCLA_ADMIN_PASSWORD (admin view); everyone else on the UCLA board
# gets BOARD_UCLA_PASSWORD. Use values different from Berkeley's; neither
# chapter's passwords open the other's hub. Whoever runs UCLA's events gets
# BOARD_UCLA_EVENTS_PASSWORD (member view plus editing events).
BOARD_UCLA_ADMIN_PASSWORD=
BOARD_UCLA_EVENTS_PASSWORD=
BOARD_UCLA_PASSWORD=
# Signs the board hub login cookies (both chapters). Any random string of 32+ characters,
# e.g. the output of: openssl rand -base64 32
BOARD_SESSION_SECRET=
# Calendar invites from the board hubs' Meetings tab go through Brevo's SMTP
# relay (Brevo → SMTP & API → SMTP: the login and an SMTP key). Each chapter's
# from address is in lib/board/chapter-server.ts; BOARD_INVITE_FROM is the
# fallback for a chapter without one.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BOARD_INVITE_FROM=board@getvindicated.org
