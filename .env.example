BREVO_API_KEY=
NEXT_PUBLIC_SITE_URL=https://www.getvindicated.org

# --- /board (password-protected board hub) ---
# Railway Postgres connection string (Railway sets this when you add the
# Postgres service and reference it from the website service).
DATABASE_URL=
# Passwords for /board. Everyone on the board gets BOARD_PASSWORD (view and
# submit). Rana gets BOARD_ADMIN_PASSWORD (edit everything). Pierce gets
# BOARD_SOCIALS_PASSWORD (edit socials). Changing one signs out everyone
# who used it.
BOARD_PASSWORD=
BOARD_ADMIN_PASSWORD=
BOARD_SOCIALS_PASSWORD=
# Signs the /board login cookie. Any random string of 32+ characters,
# e.g. the output of: openssl rand -base64 32
BOARD_SESSION_SECRET=
